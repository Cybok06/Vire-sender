# Flask / Render
FLASK_ENV=production
FRONTEND_URL=https://www.viresender.com

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/viresend?retryWrites=true&w=majority
MONGO_DB_NAME=viresend

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_HOURS=24
ADMIN_EMAIL=admin@viresender.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Abuse protection / CAPTCHA
RECAPTCHA_SECRET_KEY=YOUR_SECRET_KEY

# Social login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.viresender.com/api/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://www.viresender.com/api/auth/google/callback
GMAIL_OAUTH_REDIRECT_URI=https://www.viresender.com/api/email/google/callback
GOOGLE_CHAT_REDIRECT_URI=https://www.viresender.com/api/google-chat/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_REDIRECT_URI=https://www.viresender.com/api/auth/github/callback

# Email / SMTP
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@viresender.com
SMTP_PASSWORD=your_email_password_or_app_password
SMTP_FROM=noreply@viresender.com

# Payments
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_MIN_DEPOSIT=1
PAYSTACK_MAX_DEPOSIT=1000
# Optional: override the Paystack redirect target, useful when local development
# needs a public tunnel URL such as https://your-subdomain.ngrok-free.app/user/wallet
PAYSTACK_CALLBACK_URL=
MOOLRE_ENVIRONMENT=sandbox
MOOLRE_API_USERNAME=
MOOLRE_PRIVATE_API_KEY=
MOOLRE_PUBLIC_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_URL=
MOOLRE_REDIRECT_URL=
MOOLRE_LINK_EXPIRATION_MINUTES=30
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
MOOLRE_SMS_VAS_KEY=
MOOLRE_SMS_BASE_URL=https://api.moolre.com
MOOLRE_SMS_BATCH_SIZE=100

# VireSend AI
AI_ENABLED=true
AI_COMMUNICATION_ASSISTANT_ENABLED=true
AI_DIRECT_SMS_MAX_RECIPIENTS=20
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Bird international SMS (optional; may also be configured securely in Admin)
BIRD_API_KEY=

# Cloudflare Images (contact marketplace cover uploads)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_HASH=
CLOUDFLARE_IMAGES_VARIANT=public
# The uploader also accepts the aliases CF_ACCOUNT_ID, CF_IMAGES_TOKEN,
# CF_HASH, and CF_IMAGES_VARIANT used by the older project.
